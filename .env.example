# ---------------------------------------------------------------------------
# TrackIt — environment configuration
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# NEVER commit a real `.env`. It is git-ignored on purpose.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------

# development | production | test
NODE_ENV=development

# Port the API listens on. Railway/Render inject this automatically.
PORT=5000

# --- Database ---------------------------------------------------------------

# MongoDB connection string.
#   Local docker-compose:  mongodb://mongo:27017/trackit
#   Local mongod:          mongodb://127.0.0.1:27017/trackit
#   MongoDB Atlas:         mongodb+srv://<user>:<password>@<cluster>/trackit?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/trackit

# --- Authentication ---------------------------------------------------------

# Secret used to sign JWTs. MUST be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# How long an issued token stays valid (zeit/ms format: 30m, 12h, 7d).
JWT_EXPIRES_IN=24h

# --- HTTP / CORS ------------------------------------------------------------

# Comma-separated list of browser origins allowed to call the API.
# Use * only for local experimentation, never in production.
CORS_ORIGINS=http://localhost:3000

# Set true when this process should also serve the built React SPA
# (the single-service Docker/Railway deployment does this).
SERVE_FRONTEND=false

# Serve the API at the bare root (/issues) in addition to /api/issues.
# Defaults to true unless SERVE_FRONTEND is true, because the SPA needs
# those root paths for its own client-side routes.
# ENABLE_LEGACY_ROOT_ROUTES=true

# Trust X-Forwarded-* headers. Enable behind a proxy/load balancer
# (Railway, Render, Fly, nginx) so rate limiting sees real client IPs.
TRUST_PROXY=false

# --- Rate limiting ----------------------------------------------------------

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# --- First-run administrator ------------------------------------------------

# If set, this admin account is created (or its password reset) on boot.
# This is the supported way to bootstrap a production instance.
# ADMIN_EMAIL=admin@yourdomain.com
# ADMIN_PASSWORD=

# --- Registration -----------------------------------------------------------

# Allow anyone to create their own account via POST /auth/register.
# Defaults to true in development, false in production — an open endpoint on a
# team tool lets strangers into the workspace.
# ALLOW_PUBLIC_REGISTRATION=false

# The role a self-registered account receives. Callers can never choose their
# own role; only an administrator may set one when creating an account.
# DEFAULT_REGISTRATION_ROLE=developer

# --- Demo data --------------------------------------------------------------

# Seed the four demo accounts (admin/manager/developer/tester).
# Defaults to true in development, false in production.
# Never enable this on a public instance with SEED_DEMO_PASSWORD unset —
# without it the seeder generates random passwords and prints them once.
# SEED_DEMO_USERS=false
# SEED_DEMO_PASSWORD=

# --- External dataset sync (optional) ---------------------------------------

# The POST /api/sync endpoint pulls seed data from a coursework API.
# It stays disabled unless all three values below are provided.
# DATASET_API_URL=https://example.com/api
# DATASET_STUDENT_ID=
# DATASET_PASSWORD=
# DATASET_SET=setB

# --- Frontend (build-time) --------------------------------------------------

# Where the React app sends API requests. Leave unset for the single-service
# deployment (it defaults to same-origin /api). Set it when the frontend is
# hosted separately, e.g. https://trackit-api.up.railway.app/api
# REACT_APP_API_URL=
