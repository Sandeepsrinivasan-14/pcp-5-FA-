{
  "name": "trackit",
  "version": "1.0.0",
  "private": true,
  "description": "TrackIt — a MERN issue and bug tracking system with role-based access control",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "install:all": "npm --prefix backend ci && npm --prefix frontend ci",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend start",
    "test": "npm --prefix backend test",
    "lint": "npm --prefix backend run lint",
    "seed": "npm --prefix backend run seed",
    "smoke": "npm --prefix backend run smoke"
  }
}
